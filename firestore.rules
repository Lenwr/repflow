rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profile(userId) {
      return get(/databases/$(database)/documents/profiles/$(userId)).data;
    }

    function isCoach() {
      return signedIn() && profile(request.auth.uid).role == 'coach';
    }

    function isAdmin() {
      return signedIn() && (profile(request.auth.uid).role == 'admin' || profile(request.auth.uid).role == 'superadmin');
    }

    function isSuperAdmin() {
      return signedIn() && profile(request.auth.uid).role == 'superadmin';
    }

    function isStandardRole(role) {
      return role in ['solo', 'client', 'coach'];
    }

    match /analytics/{metricId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /admin_metrics/{metricId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    function isLinkedClient(clientId) {
      return signedIn() && exists(/databases/$(database)/documents/coach_clients/$(request.auth.uid + '_' + clientId))
        && get(/databases/$(database)/documents/coach_clients/$(request.auth.uid + '_' + clientId)).data.status == 'active';
    }

    match /profiles/{userId} {
      allow read: if isSelf(userId) || (signedIn() && resource.data.role == 'client' && isLinkedClient(userId));
      allow create: if isSelf(userId) && isStandardRole(request.resource.data.role);
      allow update: if isSelf(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if isSelf(userId);
    }

    match /coach_clients/{linkId} {
      allow read: if signedIn() && (resource.data.coach_id == request.auth.uid || resource.data.client_id == request.auth.uid);
      allow create: if isCoach() && request.resource.data.coach_id == request.auth.uid;
      allow update, delete: if isCoach() && resource.data.coach_id == request.auth.uid;
    }

    match /programs/{programId} {
      allow read: if signedIn() && (resource.data.owner_id == request.auth.uid || resource.data.client_ids[request.auth.uid] == true);
      allow create: if signedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.owner_id == request.auth.uid;
    }

    match /workouts/{workoutId} {
      allow read: if signedIn() && (resource.data.owner_id == request.auth.uid || resource.data.client_ids[request.auth.uid] == true);
      allow create, update, delete: if signedIn() && request.resource.data.owner_id == request.auth.uid;
    }

    match /workout_exercises/{exerciseId} {
      allow read: if signedIn() && (resource.data.owner_id == request.auth.uid || resource.data.client_ids[request.auth.uid] == true);
      allow create, update, delete: if signedIn() && request.resource.data.owner_id == request.auth.uid;
    }

    match /workout_logs/{logId} {
      allow read, create, update: if signedIn() && (resource.data.user_id == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /set_logs/{setLogId} {
      allow read, create, update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && resource.data.created_by == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
